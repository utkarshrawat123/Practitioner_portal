# Local development — copy to .env.local (gitignored) and run `npm run dev`.
#   cp .env.example .env.local
#
# NOTHING here is required to boot: every integration runs in mock mode when its
# key is absent and lights up when present. The three uncommented values below
# just make local admin login and stable sessions work.
#
# Production secrets are NOT set here — they go on the Cloudflare Worker via
# `wrangler secret put`. See docs/CLOUDFLARE_GO_LIVE.md.

# --- Local essentials -------------------------------------------------------
# Needed to log in at /admin (any value; this is not a production password).
ADMIN_PASSWORD=preview-admin
# Signs practitioner sessions + certificate-upload tokens. Any value locally.
SESSION_SECRET=local-dev-session-secret-not-for-production
# Base URL used for magic links, referral/invite links and cron self-calls.
PORTAL_URL=http://localhost:3100

# --- Database --------------------------------------------------------------
# Normally leave blank. `npm run dev` and `npm run preview:cf` both use the
# local emulated D1 in .wrangler/state (shared between them). DB_PATH forces the
# libSQL file path instead, and is what the test suite uses.
# DB_PATH=
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN are pre-Cloudflare leftovers — unused.

# --- Email (mock -> on-screen devLink until BOTH are set) -------------------
# RESEND_API_KEY=
# EMAIL_FROM=                      # must be a domain-verified Resend sender

# --- AI (Ask the Expert, Content Factory, chat FAQ clustering) --------------
# Gemini is preferred; ANTHROPIC_API_KEY is the fallback path. Without either,
# /api/assistant returns 503 not_configured by design.
# GEMINI_API_KEY=
# GEMINI_API_KEY2=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=               # also used by `npm run generate-lessons`

# --- Commerce (mock catalog + mock pay page until BOTH are set) -------------
# SHOPIFY_STORE_DOMAIN=            # e.g. your-store.myshopify.com
# SHOPIFY_ADMIN_TOKEN=             # scopes: write_discounts, read_orders,
#                                  #         read_products, write_draft_orders
# SHOPIFY_WEBHOOK_SECRET=          # without it /api/webhooks/shopify 401s everything
# STATS_SOURCE=                    # 'shopify-live' queries the Admin API directly
AFFILIATE_DISCOUNT_PERCENT=10
COMMISSION_PERCENT=20

# --- Referrals -------------------------------------------------------------
# REFERRAL_BONUS_GBP=50            # default 50
# REFERRAL_MAX_PER_REFERRER=       # default unlimited
# REFERRAL_REQUIRE_APPROVAL=       # 'true' holds credit for admin approval

# --- Storage / files -------------------------------------------------------
# R2_PUBLIC_BASE=                  # public R2 URL; unset -> auth-gated /api/files
# LOCAL_UPLOAD_DIR=                # off-Workers upload dir (default data/uploads)

# --- Ops -------------------------------------------------------------------
# CRON_SECRET=                     # unset locally -> /api/cron/* need no auth
# SENTRY_DSN=                      # unset -> errors go to console only
# ADMIN_ALERT_EMAIL=               # missed-chat alert recipient
# CHAT_ALERT_MINUTES=5
# NEXT_PUBLIC_FB_GROUP_URL=        # overrides the placeholder Facebook group link
